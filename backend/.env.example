MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database>
# Optional seed target; use a local MongoDB URI unless remote seeding is explicitly intended.
SEED_MONGO_URL=mongodb://127.0.0.1:27017/jobone
# Set to true only when intentionally seeding the remote database configured above.
ALLOW_REMOTE_SEED=false
PORT=5000
JWT_SECRET=replace-with-a-random-secret
BREVO_API_KEY=your-brevo-api-key
EMAIL_USERNAME=your-verified-sender@example.com
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_BUCKET_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# aiControllers.js currently reads AWS_SECRET_KEY; set it to the same value.
AWS_SECRET_KEY=your-aws-secret-access-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GEMINI_API_KEY=your-gemini-api-key
NODE_ENV=development
